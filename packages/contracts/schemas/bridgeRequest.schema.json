{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "A call from a tool to the host (CON-03).",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Chosen by the tool; the reply carries it back."
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "args": {
      "description": "The action's arguments; every action takes an object.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!__proto__$)"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema0"
      }
    }
  },
  "required": [
    "requestId",
    "action",
    "args"
  ],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!__proto__$)"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema0"
          }
        }
      ]
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "starting",
        "staging",
        "active"
      ],
      "description": "Only the browser sees the person's first interaction."
    },
    "call": {
      "description": "The tool's call, checked by the server as the host checked it."
    }
  },
  "required": [
    "workspaceId",
    "phase",
    "call"
  ],
  "additionalProperties": false,
  "description": "A tool's data call, passed on by the host page to the server (CON-03)."
}

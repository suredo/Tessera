{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "description": "Chosen by the tool; the reply carries it back."
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "result": {
          "description": "The action's result; every result is an object.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!__proto__$)"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema0"
          }
        }
      },
      "required": [
        "requestId",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "requestId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Chosen by the tool; the reply carries it back."
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when the request carried no usable ID."
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",

                "too-large",
                "unknown-action",
                "undeclared-capability",
                "not-active",
                "invalid-args",
                "stale",
                "failed"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "requestId",
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "description": "The host's reply to a tool's call (CON-03).",

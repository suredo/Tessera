{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "callIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "type": "string",
      "enum": [
        "dry-run",
        "live"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "intent",
        "create",
        "edit",
        "repair",
        "data",
        "research",
        "review",
        "acceptance"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "promptCharCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "The request's size in characters."
    },
    "systemCharCount": {
      "description": "The instructions' size in characters (GEN-03); missing in older ledgers.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "promptParts": {
      "description": "The prompt parts used, as name@version (ENG-16); missing in older ledgers.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "All input: uncached, cache writes and cache reads."
        },
        "cachedInputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "The part of the input read from the cache."
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Time spent on the call."
        }
      },
      "required": [
        "inputTokens",
        "cachedInputTokens",
        "outputTokens",
        "durationMs"
      ],
      "additionalProperties": false,
      "description": "What one model call cost (CLI-04). null means unknown, never 0."
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ok"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "failed"
            },
            "error": {
              "type": "string",
              "enum": [
                "sign_in",
                "usage_limit",
                "unavailable_model",
                "unsupported_effort",
                "schema",
                "turn_limit",
                "time_limit",
                "cancelled"
              ]
            },
            "message": {
              "type": "string"
            },
            "detail": {
              "description": "What the provider itself said: for diagnosis, never shown to the person as it is.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "error",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "crashed"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "additionalProperties": false,
          "description": "The call broke in an unexpected way: a bug, never a model failure."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "refused"
            },
            "reason": {
              "type": "string",
              "enum": [
                "call_cap",
                "stopped"
              ]
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false,
          "description": "The guard refused the call before it started; it cost nothing."
        }
      ]
    }
  },
  "required": [
    "callIndex",
    "mode",
    "provider",
    "stage",
    "model",
    "effort",
    "promptCharCount",
    "startedAt",
    "usage",
    "outcome"
  ],
  "additionalProperties": false,
  "description": "One model call in an evaluation run's ledger (OBS-01, OBS-02)."
}

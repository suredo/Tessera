{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "tool"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "The tool's name, short, in the person's language and plain words."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "What the tool does, in one or two plain sentences for the person."
        },
        "leftOut": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": "The parts of the request this tool doesn't do because no tool here can, such as reaching the internet or playing videos, each in plain words for the person. Never a part another tool here could do, or one the person says comes later. Left out when the tool does all of it."
        },
        "code": {
          "type": "object",
          "properties": {
            "html": {
              "type": "string"
            },
            "css": {
              "type": "string"
            },
            "js": {
              "type": "string"
            }
          },
          "required": [
            "html",
            "css",
            "js"
          ],
          "additionalProperties": false,
          "description": "The tool: the HTML inside its page's body, its CSS and its JavaScript."
        },
        "data": {
          "type": "object",
          "properties": {
            "schema": {
              "description": "The JSON Schema of the tool's data: an object of lists of records, each with a string id.",
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^(?!__proto__$)"
              },
              "additionalProperties": {
                "$ref": "#/definitions/__schema0"
              }
            },
            "reusableDefaults": {
              "description": "Data worth keeping when the tool is used again, such as settings or categories; never the person's own entries.",
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^(?!__proto__$)"
              },
              "additionalProperties": {
                "$ref": "#/definitions/__schema0"
              }
            },
            "initialState": {
              "description": "The entries this request itself gives, such as the items it lists; {} when it gives none.",
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^(?!__proto__$)"
              },
              "additionalProperties": {
                "$ref": "#/definitions/__schema0"
              }
            }
          },
          "required": [
            "schema",
            "reusableDefaults",
            "initialState"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "clock",
              "chart",
              "connection",
              "files"
            ]
          },
          "description": "The host capabilities the tool needs, only those it uses (CAP-01)."
        },
        "connections": {
          "description": "Each connection the tool uses, only from those the request lists, with the sample answers its checks get; left out when it uses none (CAP-02, A66, A69).",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$",
            "description": "The connection's name, how a tool asks for it: lowercase letters, digits and hyphens, starting with a letter, at most 40 characters, such as movies or home-lights."
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "samples": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^\\/(?!\\/)[^\\s#?\\\\\\p{Cc}]*$",
                  "description": "The path this answer is for, without a query, such as /search/movie. A request gets the sample whose path is the longest one its own path starts with."
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599,
                      "description": "The service's HTTP status, such as 200."
                    },
                    "contentType": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 200
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The answer's content type, such as application/json; null when it gave none."
                    },
                    "body": {
                      "type": "string",
                      "maxLength": 16384,
                      "description": "The answer's text, as the service would send it, with made-up content."
                    }
                  },
                  "required": [
                    "statusCode",
                    "contentType",
                    "body"
                  ],
                  "additionalProperties": false,
                  "description": "A made-up answer a check gets in place of the service's (A69)."
                },
                "maxProperties": 10,
                "description": "Sample answers by path, each path once (A69)."
              }
            },
            "required": [
              "samples"
            ],
            "additionalProperties": false,
            "description": "A connection the tool uses (CAP-02, A66)."
          },
          "maxProperties": 50
        },
        "uiMode": {
          "type": "string",
          "enum": [
            "standard",
            "custom"
          ],
          "description": "custom only when the person asked for their own design or to drop the standard."
        },
        "uiWidth": {
          "description": "The host panel's width: comfortable for focused forms and lists; wide for boards, timelines or tools that need the whole width. Left out means comfortable (APP-01).",
          "type": "string",
          "enum": [
            "comfortable",
            "wide"
          ]
        }
      },
      "required": [
        "outcome",
        "name",
        "summary",
        "code",
        "data",
        "capabilities",
        "uiMode"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "cannot"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Why no tool here can do this, in plain words for the person."
        }
      },
      "required": [
        "outcome",
        "reason"
      ],
      "additionalProperties": false
    }
  ],
  "description": "The create stage's answer: a new tool, or why none can be made (CON-02, GEN-05).",
  "definitions": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!__proto__$)"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema0"
          }
        }
      ]
    }
  }
}

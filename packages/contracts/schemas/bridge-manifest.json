          "args": {
            "id": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
          },
          "result": {
            "type": "image/png",
            "bytesBase64": "iVBORw0KGgo="
          }
        }
      ]

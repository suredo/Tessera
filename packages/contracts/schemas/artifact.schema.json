{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "number",
      "const": 2
    },
    "code": {
      "type": "object",
      "properties": {
        "html": {
          "type": "string"
        },
        "css": {
          "type": "string"
        },
        "js": {
          "type": "string"
        }
      },
      "required": [
        "html",
        "css",
        "js"
      ],
      "additionalProperties": false,
      "description": "The tool itself: what runs in the sandbox (RUN-01)."
    },
    "data": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "schema": {
          "description": "The JSON Schema of the tool's data (DATA-03).",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!__proto__$)"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema0"
          }
        },
        "defaults": {
          "description": "Reusable defaults, never session entries or examples (DATA-03, DATA-07).",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!__proto__$)"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema0"
          }
        },
        "migrations": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "description": "A tool's data, from one schema version to the next, as declarative operations.",
            "type": "object",
            "properties": {
              "fromVersion": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "toVersion": {
                "type": "integer",
                "minimum": 2,
                "maximum": 9007199254740991
              },
              "operations": {
                "minItems": 1,
                "maxItems": 50,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "renameCollection"
                        },
                        "from": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "The top-level list the record is in, such as `tasks`."
                        },
                        "to": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "The top-level list the record is in, such as `tasks`."
                        }
                      },
                      "required": [
                        "op",
                        "from",
                        "to"
                      ],
                      "additionalProperties": false,
                      "description": "Renames a top-level list of records."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "renameField"
                        },
                        "collection": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "The top-level list the record is in, such as `tasks`."
                        },
                        "from": {
                          "type": "string",
                          "pattern": "^(?!id$)[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "A field of a record; never `id`, which only the host sets."
                        },
                        "to": {
                          "type": "string",
                          "pattern": "^(?!id$)[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "A field of a record; never `id`, which only the host sets."
                        }
                      },
                      "required": [
                        "op",
                        "collection",
                        "from",
                        "to"
                      ],
                      "additionalProperties": false,
                      "description": "Renames a field in every record of a collection."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "addField"
                        },
                        "collection": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "The top-level list the record is in, such as `tasks`."
                        },
                        "fields": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "pattern": "^(?!id$)[A-Za-z][A-Za-z0-9_]{0,63}$",
                            "description": "A field of a record; never `id`, which only the host sets."
                          },
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 1000
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      },
                      "required": [
                        "op",
                        "collection",
                        "fields"
                      ],
                      "additionalProperties": false,
                      "description": "Gives every record of a collection that lacks one of these fields its value."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "removeField"
                        },
                        "collection": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "The top-level list the record is in, such as `tasks`."
                        },
                        "field": {
                          "type": "string",
                          "pattern": "^(?!id$)[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "A field of a record; never `id`, which only the host sets."
                        }
                      },
                      "required": [
                        "op",
                        "collection",
                        "field"
                      ],
                      "additionalProperties": false,
                      "description": "Removes a field from every record of a collection."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "mapValues"
                        },
                        "collection": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "The top-level list the record is in, such as `tasks`."
                        },
                        "field": {
                          "type": "string",
                          "pattern": "^(?!id$)[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "A field of a record; never `id`, which only the host sets."
                        },
                        "map": {
                          "minItems": 1,
                          "maxItems": 100,
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": [
                              {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 1000
                                  },
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "boolean"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 1000
                                  },
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "boolean"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            ],
                            "additionalItems": false,
                            "minItems": 2,
                            "maxItems": 2
                          },
                          "description": "Pairs of an old value and the new value that replaces it."
                        }
                      },
                      "required": [
                        "op",
                        "collection",
                        "field",
                        "map"
                      ],
                      "additionalProperties": false,
                      "description": "Replaces values of a field by a table of pairs; values not in it stay."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "setType"
                        },
                        "collection": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "The top-level list the record is in, such as `tasks`."
                        },
                        "field": {
                          "type": "string",
                          "pattern": "^(?!id$)[A-Za-z][A-Za-z0-9_]{0,63}$",
                          "description": "A field of a record; never `id`, which only the host sets."
                        },
                        "to": {
                          "type": "string",
                          "enum": [
                            "string",
                            "number"
                          ]
                        }
                      },
                      "required": [
                        "op",
                        "collection",
                        "field",
                        "to"
                      ],
                      "additionalProperties": false,
                      "description": "Converts a field: a number to its text, or a text of a plain number to the number."
                    }
                  ],
                  "description": "One declarative change to a tool's data shape (DATA-03)."
                }
              }
            },
            "required": [
              "fromVersion",
              "toVersion",
              "operations"
            ],
            "additionalProperties": false
          },
          "description": "How data of each earlier schema version reaches this one, a step at a time (DATA-03)."
        }
      },
      "required": [
        "schemaVersion",
        "schema",
        "defaults",
        "migrations"
      ],
      "additionalProperties": false,
      "description": "The tool's declared data shape and reusable defaults (DATA-03)."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*$"
      },
      "description": "The host capabilities the tool declares (CAP-01)."
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "description": "The exact dependency versions it was built against, such as engines (DATA-04)."
    },
    "ui": {
      "type": "object",
      "properties": {
        "standardVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "string",
          "enum": [
            "standard",
            "custom"
          ]
        }
      },
      "required": [
        "standardVersion",
        "mode"
      ],
      "additionalProperties": false,
      "description": "Which UI standard it follows, and whether in standard or custom mode (VER-06)."
    }
  },
  "required": [
    "contractVersion",
    "code",
    "data",
    "capabilities",
    "pins",
    "ui"
  ],
  "additionalProperties": false,
  "description": "An immutable tool version: code, data shape, defaults and pins (CON-04, DATA-04).",
  "definitions": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!__proto__$)"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema0"
          }
        }
      ]
    }
  }
}

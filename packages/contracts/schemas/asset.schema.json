{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "An asset's ID: the SHA-256 of its bytes (DATA-11)."
    },
    "type": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ]
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 26214400
    },
    "widthPx": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "heightPx": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "originalName": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ],
      "description": "The name it came with, if any."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "type",
    "sizeBytes",
    "widthPx",
    "heightPx",
    "originalName",
    "createdAt"
  ],
  "additionalProperties": false,
  "description": "A stored asset, as its row records it (DATA-11)."
}

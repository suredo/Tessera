{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "callIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stage": {
      "type": "string",
      "enum": [
        "intent",
        "create",
        "edit",
        "repair",
        "data",
        "research",
        "review",
        "acceptance"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "answer": {
      "description": "The raw answer; null when there was none.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "callIndex",
    "stage",
    "prompt",
    "answer"
  ],
  "additionalProperties": false,
  "description": "What one call of an evaluation run asked and got back (OBS-02)."
}

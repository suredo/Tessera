{
  // The TypeScript scripts: the coverage report and its tests. allowJs lets them use the shared
  // .mjs helpers with the types TypeScript infers.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true
  },
  "include": ["coverage-report.ts", "test/**/*.test.ts"]
}
